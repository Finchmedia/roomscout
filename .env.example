# Set automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Public browser token. Restrict it to the deployed RoomScout domains in Mapbox.
VITE_MAPBOX_ACCESS_TOKEN=

# The values below belong in the Convex deployment environment, not in
# `.env.local`. Set them with `npx convex env set NAME value` or in the Convex
# dashboard. They are listed here without values so the required integration
# contract is discoverable without placing secrets in the repository.

# Generation uses the Convex AI Gateway with openai/gpt-5.6-terra. The direct
# OpenAI key is used only for text-embedding-3-small and Realtime WebRTC setup.
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=marin
# REALTIME_ALLOWED_ORIGINS=http://localhost:5173,https://your-deployment.convex.site

# Firecrawl Native Monitoring. Keep monitors disabled until each pilot source
# has passed policy and extraction review. The webhook URL is the full Convex
# site URL ending in `/api/webhooks/firecrawl`.
# FIRECRAWL_API_KEY=
# Dashboard HMAC signing secret used only by the vendored durable-crawl
# component endpoint at /api/components/firecrawl/.
# FIRECRAWL_WEBHOOK_SECRET=
# Random bearer used only by Firecrawl Native Monitor callbacks at
# /api/webhooks/firecrawl. Do not reuse the dashboard HMAC secret here.
# FIRECRAWL_MONITOR_WEBHOOK_BEARER=
# FIRECRAWL_WEBHOOK_URL=
# FIRECRAWL_MONITORS_ENABLED=false

# AgentMail creates one deterministic mailbox per RoomScout user on first
# outreach. There is intentionally no global sending inbox. Use an organization-
# or pod-scoped key with inbox_create; an inbox-scoped key cannot provision users.
# AGENTMAIL_API_KEY=
# AGENTMAIL_WEBHOOK_SECRET=
# AGENTMAIL_ADDRESS_SALT=
# AGENTMAIL_DOMAIN=agentmail.to

# Secret server-side geocoding token. Persistent geocode results are cached in
# Convex; the browser uses VITE_MAPBOX_ACCESS_TOKEN instead.
# MAPBOX_SECRET_TOKEN=

# Browserbase is an operator-reviewed fallback for authenticated portals and
# human-in-the-loop login. Configure only the API key in Convex; the project is
# inferred from that key. Never add credentials, cookies, or a project ID here.
# BROWSERBASE_API_KEY=
