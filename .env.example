# The direct OpenAI key is used only for text-embedding-3-small semantic memory.
# OPENAI_API_KEY=
# FIRECRAWL_API_KEY=
# FIRECRAWL_WEBHOOK_SECRET=
# AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX_ID=
# AGENTMAIL_WEBHOOK_SECRET=
# ROOMSCOUT_FROM_EMAIL=
