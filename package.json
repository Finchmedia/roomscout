{
  "name": "roomscout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run --exclude '**/*.eval.?(m)ts'",
    "test:watch": "vitest",
    "eval:smoke": "evalite run evals/foundation-smoke.eval.ts --hideTable",
    "eval:autopilot": "node tools/evals/runAutopilot.mjs",
    "eval:typecheck": "tsc -p tools/evals/tsconfig.json --pretty false",
    "test:e2e": "playwright test",
    "postinstall": "patch-package",
    "verify:bandnet-form": "node scripts/verify-bandnet-form.mjs",
    "convex:dev": "convex dev",
    "deploy": "npx @convex-dev/static-hosting deploy"
  },
  "dependencies": {
    "@agentmail/convex": "^0.1.0",
    "@ai-sdk/openai-compatible": "3.0.14",
    "@browserbasehq/sdk": "2.19.0",
    "@browserbasehq/stagehand": "4.0.2",
    "@convex-dev/agent": "0.7.1",
    "@convex-dev/auth": "2.0.0-alpha.1",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/static-hosting": "0.2.1",
    "@convex-dev/workpool": "0.4.11",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@shadcn/react": "^0.3.1",
    "@x402/fetch": "^2.24.0",
    "ai": "7.0.83",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "convex": "1.45.0",
    "lucide-react": "1.34.0",
    "mapbox-gl": "^3.29.0",
    "playwright-core": "1.62.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.13",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "convex-test": "0.0.56",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "evalite": "0.19.0",
    "jsdom": "30.0.1",
    "patch-package": "^8.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
