      {
        "selector": "JSXOpeningElement[name.name='Composer'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onSubmit|onVoice|placeholder|label|height|showKeyboardIcon|divider|children|style|key|ref|className|style|children)$/]",
        "message": "<Composer> doesn't accept that prop. Declared props: value, onChange, onSubmit, onVoice, placeholder, label, height, showKeyboardIcon, divider, children, style."
      },
