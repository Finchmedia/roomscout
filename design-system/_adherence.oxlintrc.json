        "message": "<FactList> doesn't accept that prop. Declared props: facts, variant, title, onEdit, editing, drafts, onDraftChange, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactList'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:floating|card|compact)$/]",
        "message": "<FactList> variant must be one of 'floating' | 'card' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hint'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Hint> doesn't accept that prop. Declared props: children, style."
