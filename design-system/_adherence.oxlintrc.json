{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/avatar/**",
              "components/core/badge/**",
              "components/core/button/**",
              "components/core/capsule/**",
              "components/core/card/**",
              "components/core/icon-button/**",
              "components/core/icon/**",
              "components/core/overline/**",
              "components/core/scout-blob/**",
              "components/core/status-dot/**",
              "components/core/summary-pill/**",
              "components/core/wordmark/**",
              "components/data/data-table/**",
              "components/data/fact-list/**",
              "components/feedback/chat-bubble/**",
              "components/feedback/hint/**",
              "components/feedback/notice/**",
              "components/feedback/toast/**",
              "components/forms/composer/**",
              "components/forms/radio-card/**",
              "components/forms/stepper/**",
              "components/forms/switch/**",
              "components/forms/text-input/**",
              "components/forms/voice-control/**",
              "components/navigation/accordion/**",
              "components/navigation/app-header/**",
              "components/navigation/nav-item/**",
              "components/navigation/profile-menu/**",
              "ui_kits/landing/**",
              "ui_kits/roomscout-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist))/i]",
        "message": "Font not provided by the design system. Available: Geist."
      },
      {
        "selector": "JSXOpeningElement[name.name='Accordion'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|defaultOpen|children|style|key|ref|className|style|children)$/]",
        "message": "<Accordion> doesn't accept that prop. Declared props: question, defaultOpen, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:narrow|initials|right|onAvatar|children|style|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: narrow, initials, right, onAvatar, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|size|interactive|children|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: initials, size, interactive, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|muted|pill)$/]",
        "message": "<Badge> variant must be one of 'solid' | 'outline' | 'muted' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|block|disabled|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, block, disabled, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tint|ghost|link|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tint' | 'ghost' | 'link' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|base|sm|xs|2xs)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'base' | 'sm' | 'xs' | '2xs'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Capsule'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|children|style|key|ref|className|style|children)$/]",
        "message": "<Capsule> doesn't accept that prop. Declared props: size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Capsule'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Capsule> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|hoverLift|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: size, tone, hoverLift, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl|2xl|panel)$/]",
        "message": "<Card> size must be one of 'sm' | 'md' | 'lg' | 'xl' | '2xl' | 'panel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|soft|faint|accent|warning|inset|panel|rust)$/]",
        "message": "<Card> tone must be one of 'default' | 'soft' | 'faint' | 'accent' | 'warning' | 'inset' | 'panel' | 'rust'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:who|label|compact|children|style|key|ref|className|style|children)$/]",
        "message": "<ChatBubble> doesn't accept that prop. Declared props: who, label, compact, children, style."
